# Local configuration for holmes-bridge.
#
#   cp .env.example .env
#   # then fill in OPENROUTER_API_KEY
#
# .env is gitignored; this file is not, so keep real secrets out of it.
#
# Precedence, highest first:
#   1. a variable exported in your shell   (OPENROUTER_API_KEY=... task demo)
#   2. .env
#   3. .env.default
#
# Both `task` and the scripts under hack/ read .env, so either entry point works.
#
# Sections below are grouped by which way the traffic goes, because that is what
# decides whether a setting needs a network path in or not.


# ═══ OUTBOUND — the bridge calls these ═══════════════════════════════════════
#
# Nothing here needs to be reachable from the internet. The bridge opens the
# connection, so a laptop behind NAT is fine.


# ─── OpenRouter (required) ───────────────────────────────────────────────────
#
# Model access for HolmesGPT. Used by `task holmes:install` to create the
# holmes-openrouter Secret in your cluster.
# Get a key: https://openrouter.ai/keys

OPENROUTER_API_KEY=


# ─── incident.io API ─────────────────────────────────────────────────────────
#
# Where incidents are read from and analyses written back to. Leave the URL
# unset to use the mock; point it at https://api.incident.io for a real org.
#
# The key needs: view incidents, edit incidents, create incident updates.

# INCIDENTIO_URL=https://api.incident.io
INCIDENTIO_API_KEY=

# Start here against a real org: run the investigation and log it, but write
# nothing back. Move to `update` once the answers look useful.
# WRITE_BACK=none


# ─── HolmesGPT ───────────────────────────────────────────────────────────────
#
# The server that performs the investigations, usually in your cluster.
# HOLMES_MODEL is the KEY from its modelList (see hack/holmes-values.yaml),
# not the provider's model string.

HOLMES_MODEL=claude-sonnet
HOLMES_NAMESPACE=holmes
HOLMES_RELEASE=holmes

# HOLMES_URL=http://127.0.0.1:15050
# HOLMES_CHART_VERSION=0.40.0

# The chart grants Holmes cluster-wide read access, so installing outside a
# local context is deliberately awkward.
# ALLOW_REMOTE_CLUSTER=1


# ─── Notifications (ntfy) ────────────────────────────────────────────────────
#
# Push each finished investigation to a phone. The bridge POSTs to ntfy and
# ntfy never calls back, so this needs no inbound path and nothing to do with
# the tunnel settings further down.
#
# Most servers require a token to publish, and a token only works against the
# server that issued it — set both together. The topic is also a read secret:
# anyone who knows it can subscribe.

NTFY_TOPIC=
NTFY_SERVER=
NTFY_TOKEN=

# NTFY_ON_FAILURE=true


# ═══ INBOUND — incident.io calls the bridge ══════════════════════════════════
#
# This is the only direction that needs a network path in, and the only reason
# the tunnel exists.


# ─── Receiving webhooks from incident.io ─────────────────────────────────────
#
# From Settings → Webhooks, on the webhook pointed at the bridge. Every delivery
# is verified against this, so it must match exactly.

WEBHOOK_SECRET=

# Events that start an investigation. REPLACES the defaults rather than adding
# to them, so list every event you want.
# TRIGGERS=public_incident.incident_created_v2


# ─── Publishing the webhook endpoint (holt) ──────────────────────────────────
#
# Only needed because of the section above: incident.io has to reach the bridge,
# which is awkward on a laptop or in a cluster with no ingress. holt is a
# reverse tunnel — the bridge dials out and serves its webhook route back.
#
# Irrelevant to ntfy, to HolmesGPT, and to the incident.io API calls: those are
# all outbound.

# EXPOSE=true
# EXPOSE_PEER=holmes-bridge
# EXPOSE_PROFILE=prod

# A long-lived join token skips enrolment, so the peer identity — and therefore
# the webhook URL — survives restarts and redeploys.
# HOLT_TOKEN=


# ═══ LOCAL — ports and the demo ══════════════════════════════════════════════

# Local ports follow one rule: 1 + the conventional port, because 8080/8081 are
# the most contested ports on a development machine.
# MOCK_PORT=18080
# BRIDGE_PORT=18081
# HOLMES_PORT=15050

# Which mock scenario to serve. checkout-crashloop matches the broken workload
# in hack/demo-workload.yaml; checkout-latency does not correspond to anything
# in your cluster.
# SCENARIO=checkout-crashloop

# Skip applying hack/demo-workload.yaml.
# APPLY_WORKLOAD=0
