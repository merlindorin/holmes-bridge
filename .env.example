# Local configuration for holmes-bridge.
#
#   cp .env.example .env
#
# .env is gitignored; this file is not, so keep real secrets out of it.
#
# Precedence, highest first:
#   1. a variable exported in your shell   (HOLMES_MODEL=... task demo)
#   2. .env
#   3. .env.default
#
# Two rules for what belongs here:
#
#   • Unprefixed names are PRODUCTION configuration — the same names the bridge
#     reads in a cluster. What you put here is what you would put in a Secret.
#   • TEST_ names exist only for the local demo and the helper scripts. No
#     binary reads them, and nothing in a real deployment does either.
#
# Both `task` and the scripts under hack/ read this file.


# ═══ PRODUCTION ══════════════════════════════════════════════════════════════
#
# Read by holmes-bridge itself. Grouped by which way the traffic goes, since
# that decides whether a setting needs a network path in.


# ─── OUTBOUND: incident.io API ───────────────────────────────────────────────
#
# Only the incidentio pipeline uses these. The key needs: view incidents,
# edit incidents, create incident updates.

# INCIDENTIO_URL=https://api.incident.io
INCIDENTIO_API_KEY=

# Start here against a real org: investigate and log, write nothing back.
# WRITE_BACK=none


# ─── OUTBOUND: HolmesGPT ─────────────────────────────────────────────────────
#
# HOLMES_MODEL is the KEY from the server's modelList, not the provider's
# model string.

HOLMES_MODEL=claude-sonnet
# HOLMES_URL=http://holmes-bridge-holmes.holmes-bridge.svc.cluster.local
# HOLMES_API_KEY=


# ─── INBOUND: receiving webhooks ─────────────────────────────────────────────
#
# The only direction that needs a network path in, and the only reason the
# tunnel exists.

# From incident.io, Settings → Webhooks. Every delivery is verified against
# this, so it must match exactly.
WEBHOOK_SECRET=

# Events that start an investigation. REPLACES the defaults rather than adding
# to them, so list every event you want.
# TRIGGERS=public_incident.incident_created_v2


# ─── INBOUND: publishing the endpoint (holt) ─────────────────────────────────
#
# An alternative to an ingress: the bridge dials out to a hub and serves its
# webhook route back. Irrelevant to everything above, which is all outbound.

# EXPOSE=true
# EXPOSE_PEER=holmes-bridge
# EXPOSE_PROFILE=prod

# A long-lived join token keeps the peer identity — and the webhook URL — across
# restarts and redeploys.
# HOLT_TOKEN=


# ═══ DEPLOYMENT ══════════════════════════════════════════════════════════════
#
# Consumed by `task holmes:install` and the Helm chart when they create the
# cluster Secret. The bridge itself never reads these — HolmesGPT does.

# Model access for HolmesGPT: https://openrouter.ai/keys
OPENROUTER_API_KEY=

HOLMES_NAMESPACE=holmes-bridge
HOLMES_RELEASE=holmes-bridge

# HOLMES_CHART_VERSION=0.40.0
# HOLMES_VALUES=hack/holmes-values.yaml

# The chart grants HolmesGPT cluster-wide read access, so installing outside a
# local context is deliberately awkward.
# ALLOW_REMOTE_CLUSTER=1


# ═══ TEST ════════════════════════════════════════════════════════════════════
#
# Local demo and helper scripts only. No binary reads any of these, and nothing
# in a deployment does either — which is what the prefix is for.

# Local ports follow one rule: 1 + the conventional port, because 8080/8081 are
# the most contested ports on a development machine.
# TEST_MOCK_PORT=18080
# TEST_BRIDGE_PORT=18081
# TEST_HOLMES_PORT=15050

# Which mock scenario `task demo` serves. checkout-crashloop matches the broken
# workload in hack/demo-workload.yaml; checkout-latency does not correspond to
# anything in your cluster.
# TEST_SCENARIO=checkout-crashloop

# Skip applying hack/demo-workload.yaml.
# TEST_APPLY_WORKLOAD=0
