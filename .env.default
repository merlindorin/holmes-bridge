# Committed defaults. Lowest precedence: .env overrides this, and a variable
# exported in your shell overrides both.
#
# Secrets do not belong here — this file is tracked. Put them in .env.

# Production.
HOLMES_MODEL=claude-sonnet

# Deployment tooling.
HOLMES_NAMESPACE=holmes-bridge
HOLMES_RELEASE=holmes-bridge

# Test only.
TEST_SCENARIO=checkout-crashloop
